{
  "name": "@portal-poc/platform-contract",
  "version": "1.1.0",
  "description": "Portal platform contract: types only + PLATFORM_CONTRACT_VERSION. The only thing every team must agree on.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src && fallow dead-code",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@portal-poc/presets": "workspace:*",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "fallow": "^3.35.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/portal-poc/platform.git",
    "directory": "packages/platform-contract"
  }
}
