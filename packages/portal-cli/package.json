{
  "name": "@portal-poc/cli",
  "version": "1.0.1",
  "description": "Portal CLI: create remotes from the reference template, add FSD slices, verify the integration contract.",
  "type": "module",
  "bin": {
    "portal-cli": "./bin/portal-cli.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src && fallow dead-code",
    "test": "vitest run"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.4",
    "@portal-poc/mf-shared": "workspace:^",
    "@portal-poc/presets": "workspace:^",
    "commander": "^15.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "fallow": "^3.35.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "bin": {
      "portal-cli": "./dist/main.js"
    },
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/portal-poc/platform.git",
    "directory": "packages/portal-cli"
