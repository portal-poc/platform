{
  "name": "__NAME__-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port __PORT__ --strictPort",
    "dev:standalone": "vite --port __PORT__ --strictPort --open",
    "build": "vite build && vite build --mode bridge",
    "preview": "vite preview --port __PORT__ --strictPort",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint . && steiger ./src && fallow dead-code",
    "analyze": "fallow",
    "test": "vitest run --passWithNoTests",
    "verify": "portal-cli verify && portal-cli verify --dist dist-bridge --mode bridge"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@module-federation/bridge-react": "^2.9.2",
    "@mui/joy": "5.0.0-beta.52",
    "@portal/ds": "__PORTAL_VERSION__",
    "@portal/platform-contract": "__PORTAL_VERSION__",
    "@portal/platform-runtime": "__PORTAL_VERSION__",
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@module-federation/vite": "^1.23.5",
    "@portal/presets": "__PORTAL_VERSION__",
    "@portal/vite-config": "__PORTAL_VERSION__",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "fallow": "^3.35.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "portal-cli": "__PORTAL_VERSION__",
    "steiger": "^0.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
