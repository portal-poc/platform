{
  "name": "@portal-poc/platform-runtime",
  "version": "2.2.1",
  "description": "Portal platform runtime: providers, auth adapters, QueryClient factory, devtools, standalone harness, compat checks. Bundled into every application (not an MF singleton). HTTP: @portal-poc/http.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./msal": "./src/msal/index.ts",
    "./router": "./src/router/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./msal": {
        "types": "./dist/msal/index.d.ts",
        "import": "./dist/msal/index.js"
      },
      "./router": {
        "types": "./dist/router/index.d.ts",
        "import": "./dist/router/index.js"
      }
    },
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint src && fallow dead-code",
    "test": "vitest run"
  },
  "dependencies": {
    "@portal-poc/platform-contract": "workspace:*",
    "@tanstack/react-query-devtools": "^5.104.5"
  },
  "peerDependencies": {
    "@azure/msal-browser": "^5.0.0",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.0"
  },
  "peerDependenciesMeta": {
    "@azure/msal-browser": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@azure/msal-browser": "^5.26.0",
    "@portal-poc/presets": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "fallow": "^3.35.0",
    "react-router": "^8.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/portal-poc/platform.git",
    "directory": "packages/platform-runtime"
  }
}
